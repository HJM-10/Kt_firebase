# API URL should use HTTPS in deployment.
VITE_API_URL=http://localhost:5000/api
# Optional Google Maps JavaScript API key restricted to your deployed website.
# Without it, the interactive picker uses OpenStreetMap; Google directions work.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# For larger deployments, configure your own licensed tile provider & attribution.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=
