{$APP_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  @backend path /api/* /socket.io/*
  reverse_proxy @backend api_a:5000 api_b:5000 {
    lb_policy cookie arena_backend
    health_uri /api/ready
    health_interval 10s
    health_timeout 4s
    fail_duration 15s
  }
  reverse_proxy web:8080
}
