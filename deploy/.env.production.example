APP_DOMAIN=sports.your-existing-domain.example
DATABASE_URL=mysql://APP_USER:REPLACE_PASSWORD@your-private-mysql:3306/smart_sports_hub?connection_limit=10&pool_timeout=10
REDIS_URL=rediss://APP_USER:REPLACE_PASSWORD@your-private-redis:6380
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://sports.your-existing-domain.example
PUBLIC_API_URL=https://sports.your-existing-domain.example
FIREBASE_ENABLED=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=your-existing-project-id
FIREBASE_WEB_API_KEY=
# Prefer workload identity/application-default credentials on your provider.
# If using a private service-account file, mount it read-only and set its path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
