# Copy to .env after obtaining a local MySQL database and its credentials.
# This template does not create a database or contain working credentials.
DATABASE_URL="mysql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:3306/smart_sports_hub"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_API_URL=http://localhost:5000

# Optional integrations. Leave disabled/unset until configured and tested.
FIREBASE_ENABLED=false
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/private-service-account.json
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
